# Import required libraries from pyspark.sql.functions import * from retrying import retry # Install with pip install retrying import time import logging # Configure logging logging.basicConfig(level=logging.INFO) logger = logging.getLogger("AutoloaderPipeline") # Retry configuration MAX_RETRIES = 5 INITIAL_BACKOFF = 1 # seconds BACKOFF_MULTIPLIER = 2 # Spark session configuration for retries spark.conf.set("spark.sql.streaming.minBatchesToRetain", 100) spark.conf.set("spark.sql.streaming.stateStore.providerClass", "com.databricks.sql.streaming.state.RocksDBStateStoreProvider") spark.conf.set("spark.task.maxFailures", 3) # Task-level retries spark.conf.set("spark.yarn.maxAppAttempts", 2) # Cluster-level retries # Path configurations source_path = "/mnt/s3-bucket/input/" checkpoint_path = "/mnt/adls-checkpoints/retry_checkpoint" schema_location = "/mnt/adls-checkpoints/retry_schema" output_path = "/mnt/adls-container/output/" error_path = "/mnt/adls-container/errors/" # Retry decorator with exponential backoff def retry_on_exception(exception): return isinstance(exception, (IOError, TimeoutError)) @retry(wait_exponential_multiplier=INITIAL_BACKOFF*1000, wait_exponential_max=10000, stop_max_attempt_number=MAX_RETRIES, retry_on_exception=retry_on_exception) def process_batch_with_retry(batch_df, batch_id): try: # Your custom processing logic here batch_df.write.format("delta").mode("append").save(output_path) except Exception as e: logger.error(f"Batch {batch_id} failed: {str(e)}") raise # Configure Autoloader with enhanced retry settings stream_df = (spark.readStream .format("cloudFiles") .option("cloudFiles.format", "json") .option("cloudFiles.schemaLocation", schema_location) .option("cloudFiles.schemaEvolutionMode", "rescue") .option("cloudFiles.maxFilesPerTrigger", 100) .option("cloudFiles.useNotifications", "true") .option("cloudFiles.backoffInterval", "10s") # S3 polling backoff .option("cloudFiles.retryTimeout", "1h") # Total retry timeout .option("cloudFiles.maxRetries", MAX_RETRIES) # File read retries .option("badRecordsPath", error_path) .load(source_path)) # Processing pipeline with watermarking processed_df = (stream_df .withWatermark("event_ts", "5 minutes") .withColumn("processing_ts", current_timestamp())) # Streaming write with Delta Lake retry configuration stream_query = (processed_df.writeStream .format("delta") .outputMode("append") .option("checkpointLocation", checkpoint_path) .option("maxRetries", MAX_RETRIES) # Write attempts .option("retryWaitDuration", "30s") # Wait between retries .option("delta.autoOptimize.optimizeWrite", "true") .trigger(processingTime='10 seconds') .foreachBatch(lambda df, id: process_batch_with_retry(df, id)) .start()) # Cluster recovery configuration (for job clusters) spark.conf.set("spark.databricks.clusterUsageTags.clusterSource", "JOB") spark.conf.set("spark.databricks.retryOnDisconnect.enabled", "true") spark.conf.set("spark.databricks.retryOnDisconnect.maxTries", 3) # Error handling stream with retries error_stream = (spark.readStream .format("cloudFiles") .option("cloudFiles.format", "json") .option("cloudFiles.schemaLocation", f"{schema_location}_errors") .option("cloudFiles.maxRetries", MAX_RETRIES) .load(error_path)) (error_stream.writeStream .format("delta") .option("checkpointLocation", f"{checkpoint_path}_errors") .option("maxRetries", MAX_RETRIES) .outputMode("append") .trigger(processingTime='30 seconds') .start("/mnt/adls-container/error_logs")) # Monitoring and recovery logic def monitor_stream(): while True: try: for query in spark.streams.active: status = query.lastProgress if query.status['message'] != 'Active': logger.warning(f"Query {query.name} in status {query.status}") if query.status['isDataAvailable'] and not query.status['isTriggerActive']: logger.info("Attempting query restart") query.stop() query.start() time.sleep(10) except Exception as e: logger.error(f"Monitoring failed: {str(e)}") raise # Start monitoring thread import threading monitor_thread = threading.Thread(target=monitor_stream) monitor_thread.start() # Keep the stream alive try: stream_query.awaitTermination() finally: logger.info("Stopping all streams") spark.streams.active().stop() monitor_thread.join()
